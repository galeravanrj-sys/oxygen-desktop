{
  "name": "oxygen-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:android": "vite --mode android --host 0.0.0.0 --port 1420 --strictPort",
    "build:android": "tsc -b && vite build --mode android",
    "android:init": "node scripts/android.mjs init",
    "android:dev": "node scripts/android.mjs dev",
    "android:build": "node scripts/android.mjs build --debug --target aarch64 --apk --ci",
    "android:doctor": "node scripts/android.mjs doctor",
    "build:admin": "tsc -b && vite build --mode admin && node scripts/prepare-admin-dist.mjs",
    "android:admin:build": "node scripts/android.mjs build-admin --debug --target aarch64 --apk --ci"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "decimal.js": "10.6.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
